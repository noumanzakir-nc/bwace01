# BW-ACE live SAP OData connection. Copy to .env and fill in.
# .env is git-ignored and is never read or written by the application except at startup.
# Values are never displayed in the UI or written to logs.

# Application password gate. When set, visitors must enter this password before
# the app renders. Leave blank or unset for open access.
APP_PASSWORD=

# Required
BWACE_ODATA_BASE_URL=https://sapgw.example.corp:44300
BWACE_ODATA_USER=
BWACE_ODATA_PASSWORD=

# Optional
BWACE_ODATA_SERVICE_ROOT=/sap/opu/odata/sap
BWACE_ODATA_CA_BUNDLE=
BWACE_ODATA_TIMEOUT_SECONDS=30
BWACE_ODATA_MAX_RECORDS=5000

# Service paths. These defaults are PLACEHOLDERS taken from the original feature
# request; no SAP-delivered OData service by these names could be found. Point
# them at the services activated in your own SAP Gateway.
BWACE_ODATA_SERVICE_INVENTORY=RSOD_CATALOG_SRV/ObjectCatalog
BWACE_ODATA_SERVICE_COMPLEXITY=RSOD_ADSO_SRV/AdsoMetadata
BWACE_ODATA_SERVICE_VOLUME=RSOD_ADSO_SRV/AdsoVolume
BWACE_ODATA_SERVICE_DEPENDENCIES=RSPC_API_SRV/ProcessChains
BWACE_ODATA_SERVICE_USAGE=RSOD_USAGE_SRV/Results

# The criticality matrix has no live source: business criticality, migration
# priority and downtime tolerance are business judgements, not BW metadata.
# It always comes from the bundled or an uploaded file.
